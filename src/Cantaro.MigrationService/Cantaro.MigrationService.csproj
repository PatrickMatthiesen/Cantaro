<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Cantaro.MigrationService-cc06337f-fbd6-49ab-997b-a84e32b7fd78</UserSecretsId>
    <CantaroApiAppSettingsPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Cantaro.Api\appsettings.json'))</CantaroApiAppSettingsPath>
    <CantaroApiDevelopmentAppSettingsPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Cantaro.Api\appsettings.Development.json'))</CantaroApiDevelopmentAppSettingsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.0-preview.1.26421.15" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <ProjectReference Include="..\Cantaro.ServiceDefaults\Cantaro.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Cantaro.Api\Cantaro.Api.csproj" />
  </ItemGroup>

  <Target Name="RemoveReferencedApiPublishContent" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.FullPath)' == '$(CantaroApiAppSettingsPath)' Or '%(ResolvedFileToPublish.FullPath)' == '$(CantaroApiDevelopmentAppSettingsPath)'" />
    </ItemGroup>
  </Target>
</Project>
