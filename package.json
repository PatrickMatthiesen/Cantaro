{
    "name": "cantaro-repo",
    "private": true,
    "packageManager": "bun@1.3.3",
    "workspaces": [
        "src/Cantaro.ClientShared",
        "src/Cantaro.Web",
        "src/Cantaro.BrowserExtension"
    ],
    "scripts": {
        "check:shared": "cd src/Cantaro.ClientShared && bun run check",
        "check:web": "cd src/Cantaro.Web && bun run check",
        "check:extension": "cd src/Cantaro.BrowserExtension && bun run check",
        "check": "bun run check:shared && bun run check:web && bun run check:extension",
        "check:fallow:shared": "cd src/Cantaro.ClientShared && bun run check:fallow",
        "check:fallow:web": "cd src/Cantaro.Web && bun run check:fallow",
        "check:fallow:extension": "cd src/Cantaro.BrowserExtension && bun run check:fallow",
        "check:fallow": "bun run check:fallow:shared && bun run check:fallow:web && bun run check:fallow:extension",
        "build": "bun run build:web && bun run build:extension",
        "build:web": "cd src/Cantaro.Web && bun run build",
        "build:extension": "cd src/Cantaro.BrowserExtension && bun run build",
        "compose:up": "docker compose -p cantaro up"
    }
}
