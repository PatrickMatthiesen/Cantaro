meta {
  name: /api/login
  type: http
  seq: 3
}

post {
  url: http://{{host}}:{{webPort}}/api/login
  body: json
  auth: none
}

body:json {
  {
    "email": "patrickTest@test.dk",
    "password": "This!sAStrongP4ssw0rd"
  }
}

vars:post-response {
  accessToken: req.body.accessToken
}

script:pre-request {
  req.setUrl(req.url + "?setCookie=false")
  req.headers.Authorization = undefined
}

script:post-response {
  bru.setVar("accessToken", res.body.accessToken)
  bru.setVar("refreshToken", res.body.refreshToken)
}

settings {
  encodeUrl: true
  timeout: 0
}
